          },
          "expiresIn": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          }
        }
      },
      "Role": {
        "type": "integer"
      },
      "UpdateCarRequestDTO": {
        "required": [
