        "properties": {
          "timeMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "trackId": {
            "type": "string",
            "format": "uuid"
          },
