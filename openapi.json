  "components": {
    "schemas": {
      "AddCarRequestDTO": {
        "required": [
          "brand",
          "model"
        ],
        "type": "object",
        "properties": {
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        }
      },
